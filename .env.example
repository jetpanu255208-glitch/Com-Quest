# ==============================================================================
# COM QUEST — Environment Variables Configuration (.env.example)
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# App URL for OAuth redirects (optional in local development, defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
